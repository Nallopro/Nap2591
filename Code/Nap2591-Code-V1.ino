unsigned long buzzerHasta = 0;
bool buzzerActivo = false;

// Modo de medicion
bool modoFast = true;
bool ultimoModoFast = true;

// Lectura temporizada del sensor
unsigned long ultimaLecturaSensor = 0;
const unsigned long intervaloLecturaSensor = 800;

// Pulsacion larga del boton
unsigned long tiempoInicioPulsacion = 0;
bool pulsacionLargaEjecutada = false;
const unsigned long tiempoPulsacionLargaMs = 2500;

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Sensor TSL2591
Adafruit_TSL2591 tsl = Adafruit_TSL2591(2591);

// Estadisticas lux
float luxMin = NAN;
float luxMax = NAN;
float luxSuma = 0.0;
unsigned long luxMuestras = 0;

// Estado pantalla
bool pantallaEncendida = true;

// Variables boton
bool ultimoEstadoLeido = HIGH;
bool estadoEstable = HIGH;
bool estadoEstableAnterior = HIGH;

unsigned long ultimoCambioBoton = 0;
unsigned long bloqueoBotonHasta = 0;

const unsigned long debounceMs = 30;
const unsigned long bloqueoDespuesDeSoltarMs = 500;


void configurarTSL2591() {
  if (modoFast) {
    tsl.setGain(TSL2591_GAIN_MED);
    tsl.setTiming(TSL2591_INTEGRATIONTIME_100MS);
  } else {
    tsl.setGain(TSL2591_GAIN_MAX);
    tsl.setTiming(TSL2591_INTEGRATIONTIME_600MS);
  }
  display.ssd1306_command(SSD1306_SETCONTRAST);

  if (modoFast) {
    display.ssd1306_command(255);  // brillo FAST
  } else {
    display.ssd1306_command(5);  // brillo SLOW
  }
}



void mostrarLogoInicio() {
  display.clearDisplay();
  display.invertDisplay(false);

  display.drawBitmap(
    0, 0,
    epd_bitmap_IMG_6257,
    128, 64,
    SSD1306_BLACK,  // bits 1 del bitmap
    SSD1306_WHITE   // bits 0 del bitmap
  );

  display.display();
  delay(2500);

  display.clearDisplay();
  display.display();
}

void cambiarPantalla() {
  pantallaEncendida = !pantallaEncendida;

  if (pantallaEncendida) {
    // Al encender, no mostramos "Pantalla ON".
    // Simplemente encendemos y dejamos que el loop pinte los lux.
    display.ssd1306_command(SSD1306_DISPLAYON);
    display.clearDisplay();
    display.display();

    // Forzar lectura rapida para que no se quede negra mucho rato
    ultimaLecturaSensor = millis() - intervaloLecturaSensor;

  } else {
    // Imagen antes de apagar
    display.ssd1306_command(SSD1306_DISPLAYON);
    display.clearDisplay();
    display.invertDisplay(false);

    display.drawBitmap(
      0, 0,
      epd_bitmap_IMG_6441,
      128, 64,
      SSD1306_BLACK,
      SSD1306_WHITE);

    display.display();

    delay(750);

    display.clearDisplay();
    display.display();
    display.ssd1306_command(SSD1306_DISPLAYOFF);
  }
}


void dormirDuranteMedicionTSL() {
  if (buzzerActivo) {
    delay(modoFast ? 120 : 650);
    return;
  }

  uint64_t tiempoUs = modoFast ? 120000ULL : 650000ULL;

  esp_sleep_enable_timer_wakeup(tiempoUs);

  esp_sleep_enable_gpio_wakeup();
  gpio_wakeup_enable((gpio_num_t)BUTTON_PIN, GPIO_INTR_LOW_LEVEL);
  gpio_wakeup_enable((gpio_num_t)SWITCH_PIN, GPIO_INTR_ANYEDGE);

  esp_light_sleep_start();

  gpio_wakeup_disable((gpio_num_t)BUTTON_PIN);
  gpio_wakeup_disable((gpio_num_t)SWITCH_PIN);
}

void setup() {
  setCpuFrequencyMhz(40);

  esp_pm_config_t pm_config = {
    .max_freq_mhz = 40,
    .min_freq_mhz = 10,
    .light_sleep_enable = true
  };

  esp_pm_configure(&pm_config);

  DBG_BEGIN(115200);

  delay(1000);
  pinMode(BATTERY_PIN, INPUT);
  analogReadResolution(12);
  pinMode(SWITCH_PIN, INPUT_PULLUP);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  tiririInicio();

  // Iniciar I2C en SDA 21 y SCL 20
  Wire.begin(SDA_PIN, SCL_PIN);

  DBG_PRINTLN("Iniciando TSL2591 y SSD1306...");

  // Iniciar pantalla
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    DBG_PRINTLN("Error: no se encontro la pantalla SSD1306");
    while (1)
      ;
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);

  mostrarLogoInicio();
  display.ssd1306_command(SSD1306_SETCONTRAST);
  display.ssd1306_command(modoFast ? 255 : 5);

  // Iniciar sensor TSL2591
  if (!tsl.begin()) {
    DBG_PRINTLN("Error: no se encontro el sensor TSL2591");

    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("Error TSL2591");
    display.println("No detectado");
    display.display();

    while (1)
      ;
  }

  modoFast = digitalRead(SWITCH_PIN) == HIGH;
  ultimoModoFast = modoFast;
  configurarTSL2591();

  DBG_PRINTLN("Sensor TSL2591 detectado correctamente");
  DBG_PRINTLN("Boton en GPIO10 configurado");
}

void resetearEstadisticas() {
  luxMin = NAN;
  luxMax = NAN;
  luxSuma = 0.0;
  luxMuestras = 0;

  DBG_PRINTLN("Estadisticas reiniciadas");

  if (pantallaEncendida) {
    display.clearDisplay();
    display.invertDisplay(false);

    display.drawBitmap(
      0, 0,
      epd_bitmap_IMG_6447,  // aqui va tu imagen
      128, 64,
      SSD1306_BLACK,
      SSD1306_WHITE);

    display.display();

    delay(1250);
  }
}

void leerBoton() {
  bool lectura = digitalRead(BUTTON_PIN);
  unsigned long ahora = millis();

  if (ahora < bloqueoBotonHasta) {
    ultimoEstadoLeido = lectura;
    estadoEstable = lectura;
    estadoEstableAnterior = lectura;
    return;
  }

  if (lectura != ultimoEstadoLeido) {
    ultimoCambioBoton = ahora;
    ultimoEstadoLeido = lectura;
  }

  if ((ahora - ultimoCambioBoton) > debounceMs) {
    estadoEstable = lectura;
  }

  if (estadoEstableAnterior == HIGH && estadoEstable == LOW) {
    tiempoInicioPulsacion = ahora;
    pulsacionLargaEjecutada = false;
  }

  if (estadoEstable == LOW && !pulsacionLargaEjecutada) {
    if (ahora - tiempoInicioPulsacion >= tiempoPulsacionLargaMs) {
      beep(1250, 250);  // sonido distinto para reset
      resetearEstadisticas();
      pulsacionLargaEjecutada = true;
    }
  }

  if (estadoEstableAnterior == LOW && estadoEstable == HIGH) {
    beep(700, 500);

    if (!pulsacionLargaEjecutada) {
      cambiarPantalla();
    }

    bloqueoBotonHasta = ahora + bloqueoDespuesDeSoltarMs;

    ultimoEstadoLeido = HIGH;
    estadoEstable = HIGH;
    estadoEstableAnterior = HIGH;

    return;
  }

  estadoEstableAnterior = estadoEstable;
}

void leerSwitchModo() {
  modoFast = digitalRead(SWITCH_PIN) == HIGH;

  if (modoFast != ultimoModoFast) {
    configurarTSL2591();

    // Pip al cambiar FAST/SLOW
    beep(1000, 250);

    DBG_PRINT("Modo cambiado a: ");
    DBG_PRINTLN(modoFast ? "FAST 100ms" : "SLOW 300ms");

    ultimoModoFast = modoFast;
  }
}

void imprimirLux(float lux, bool saturado = false) {
  if (saturado) {
    display.print("Too high");
    return;
  }

  if (isnan(lux)) {
    display.print("nan");
    return;
  }

  if (isinf(lux) || lux < 0.0002) {
    display.print("Too low");
    return;
  }

  if (lux >= 100.0) {
    display.print(lux, 0);
  } else if (lux >= 10.0) {
    display.print(lux, 1);
  } else if (lux >= 1.0) {
    display.print(lux, 2);
  } else if (lux >= 0.1) {
    display.print(lux, 3);
  } else {
    display.print(lux, 4);
  }
}

float leerVoltajeBateria() {
  int adc = analogRead(BATTERY_PIN);

  // Calibracion directa:
  // Ajusta este numero si hace falta
  float voltajeReal = adc * Adc_multiplier;

  return voltajeReal;
}

void dibujarBateria(int x, int y, float voltaje) {
  // Cuerpo bateria
  display.drawRect(x, y, 16, 8, SSD1306_WHITE);

  // Punta bateria
  display.fillRect(x + 16, y + 2, 2, 4, SSD1306_WHITE);

  // Estimacion simple para una celda Li-ion
  int barras = 0;

  if (voltaje >= 2.8) {
    barras = 4;
  } else if (voltaje >= 2.65) {
    barras = 3;
  } else if (voltaje >= 2.45) {
    barras = 2;
  } else if (voltaje >= 2.3) {
    barras = 1;
  } else {
    barras = 0;
  }

  for (int i = 0; i < barras; i++) {
    display.fillRect(x + 2 + (i * 3), y + 2, 2, 4, SSD1306_WHITE);
  }
}

void beep(int frecuencia, int duracionMs) {
  tone(BUZZER_PIN, frecuencia);
  buzzerHasta = millis() + duracionMs;
  buzzerActivo = true;
}

void actualizarBuzzer() {
  if (buzzerActivo && millis() >= buzzerHasta) {
    noTone(BUZZER_PIN);
    buzzerActivo = false;
  }
}

void tiririInicio() {
  tone(BUZZER_PIN, 900);
  delay(180);
  tone(BUZZER_PIN, 1200);
  delay(180);
  tone(BUZZER_PIN, 1500);
  delay(180);
  tone(BUZZER_PIN, 1200);
  delay(210);
  noTone(BUZZER_PIN);
}

void ajustarGananciaFast(float lux, bool saturado) {
  if (!modoFast) return;

  if (saturado) {
    tsl.setGain(TSL2591_GAIN_LOW);
    return;
  }

  if (isnan(lux) || isinf(lux)) return;

  // Si en FAST da "Too low", forzar ganancia minima
  // "Too low" ocurre cuando lux < 0.0002 en imprimirLux()
  if (lux < 0.0002) {
    tsl.setGain(TSL2591_GAIN_LOW);
    return;
  }

  if (lux > 700.0) {
    tsl.setGain(TSL2591_GAIN_LOW);
  } else {
    tsl.setGain(TSL2591_GAIN_MED);
  }
}

void loop() {
  leerBoton();
  leerSwitchModo();
  actualizarBuzzer();

  // El sensor solo se lee cada 800 ms
  if (millis() - ultimaLecturaSensor >= intervaloLecturaSensor) {
    ultimaLecturaSensor = millis();

    tsl.enable();
    dormirDuranteMedicionTSL();
    uint32_t lum = tsl.getFullLuminosity();
    tsl.disable();

    uint16_t ir = lum >> 16;
    uint16_t full = lum & 0xFFFF;

    bool saturado = (full >= 65000 || ir >= 65000);

    int32_t visible = (int32_t)full - (int32_t)ir;
    if (visible < 0) {
      visible = 0;
    }

    float lux = NAN;

    if (!saturado) {
      lux = tsl.calculateLux(full, ir);
    }

    ajustarGananciaFast(lux, saturado);

    if (!saturado && !isnan(lux) && !isinf(lux) && lux >= 0) {
      if (isnan(luxMin) || lux < luxMin) {
        luxMin = lux;
      }

      if (isnan(luxMax) || lux > luxMax) {
        luxMax = lux;
      }

      luxSuma += lux;
      luxMuestras++;
    }

    float luxMedia = NAN;
    if (luxMuestras > 0) {
      luxMedia = luxSuma / luxMuestras;
    }

    float voltajeBateria = leerVoltajeBateria();

    DBG_PRINTLN("---------------------");

    DBG_PRINT("Modo: ");
    DBG_PRINTLN(modoFast ? "FAST 100ms" : "SLOW 600ms");


    DBG_PRINT("IR: ");
    if (saturado) {
      DBG_PRINTLN("Overrun");
    } else {
      DBG_PRINTLN(ir);
    }

    DBG_PRINT("Visible: ");
    if (saturado) {
      DBG_PRINTLN("Overrun");
    } else {
      DBG_PRINTLN(visible);
    }

    DBG_PRINT("Lux: ");
    DBG_PRINTLN2(lux, 2);

    DBG_PRINT("Pantalla: ");
    DBG_PRINTLN(pantallaEncendida ? "ON" : "OFF");

    DBG_PRINT("Battery: ");
    DBG_PRINT2(voltajeBateria, 2);
    DBG_PRINTLN(" V");

    if (pantallaEncendida) {
      display.clearDisplay();

      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);

      display.setCursor(0, 0);
      display.print("Lux: ");
      imprimirLux(lux, saturado);
      display.println();


      // Bateria / USB arriba derecha

      if (voltajeBateria < 0.5) {
        display.drawBitmap(86, 0, icon_usb, 8, 8, SSD1306_WHITE);

        display.setCursor(102, 0);
        display.print("USB");
      } else {
        dibujarBateria(82, 0, voltajeBateria);

        display.setCursor(102, 0);
        display.print(voltajeBateria, 1);
        display.print("V");
      }
      // FAST/SLOW una linea mas abajo
      display.setCursor(98, 12);
      display.print(modoFast ? "FAST" : "SLOW");

      display.setCursor(0, 12);
      display.print("Min: ");
      imprimirLux(luxMin);
      display.println();

      display.setCursor(0, 24);
      display.print("Max: ");
      imprimirLux(luxMax);
      display.println();

      display.setCursor(0, 36);
      display.print("Avg: ");
      imprimirLux(luxMedia);
      display.println();

      display.setCursor(0, 48);
      display.print("IR:");
      if (saturado) {
        display.print("Over:/");
      } else {
        display.print(ir);
      }

      display.setCursor(68, 48);
      display.print("Vis:");
      if (saturado) {
        display.print("Over:/");
      } else {
        display.print(visible);
      }


      display.display();
    }
  }
}
